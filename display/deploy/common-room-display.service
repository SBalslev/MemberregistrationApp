[Unit]
Description=Medlemscheckin common-room display service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=display
Group=display
WorkingDirectory=/opt/medlemscheckin-display
ExecStart=/opt/medlemscheckin-display/.venv/bin/common-room-display --config /etc/medlemscheckin-display/config.json
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/medlemscheckin-display

[Install]
WantedBy=multi-user.target
